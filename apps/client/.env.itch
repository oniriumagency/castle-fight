# `pnpm build:itch`: the game for itch.io, inside itch's iframe on another domain.
# The API, WebSockets and reports go to the published Worker (CORS is open there).
VITE_SERVER_URL=https://games.onirium.agency
# Invite links open the game on our own site: itch's frame does not pass ?room= on.
VITE_INVITE_URL=https://games.onirium.agency/cardcraft-castles/
