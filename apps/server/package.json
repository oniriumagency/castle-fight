{
  "name": "@cardcraft-castles/server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor autoritativo de Cardcraft: Castles en Cloudflare Workers + Durable Objects",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json && tsc -p test/tsconfig.json",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@cardcraft-castles/engine": "workspace:*",
    "@cardcraft-castles/protocol": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  }
}
