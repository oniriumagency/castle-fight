{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cardcraft-castles",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "ROOM", "class_name": "Room" },
      { "name": "REPORTS", "class_name": "Reports" }
    ]
  },
  // SQLite-backed Durable Objects are the ones available on the free plan.
  // v2: the players' bug reports and suggestions (see src/reports.ts).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Lobby", "Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Reports"] }
  ],

  // The top level is what `pnpm dev` and the tests run: the API alone.
  // `--env production` is games.onirium.agency: the same Worker, plus the built
  // site (games library + game) as static assets, on its own domain. See the README.
  "env": {
    // A test copy of the game for branches (see .github/workflows/preview.yml):
    // its own Worker, rooms and reports on workers.dev, so nothing reaches
    // games.onirium.agency or its players.
    "preview": {
      "name": "cardcraft-castles-preview",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "../client/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/reportes"]
      },
      "observability": { "enabled": true },
      "durable_objects": {
        "bindings": [
          { "name": "LOBBY", "class_name": "Lobby" },
          { "name": "ROOM", "class_name": "Room" },
          { "name": "REPORTS", "class_name": "Reports" }
        ]
      }
    },
    "production": {
      // Keep the Worker's name instead of the default `cardcraft-castles-production`.
      "name": "cardcraft-castles",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "games.onirium.agency", "custom_domain": true }],
      // The whole site, built by apps/library: the games library at `/` and
      // the game under `/cardcraft-castles/`. The Worker answers `/` first, to
      // send invite links from before the library (`/?room=<id>`) to the game.
      "assets": {
        "directory": "../library/dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": ["/", "/api/*", "/reportes"]
      },
      "vars": { "LIBRARY": "on" },
      "observability": { "enabled": true },
      // Bindings are not inherited by environments: keep this equal to the list above.
      "durable_objects": {
        "bindings": [
          { "name": "LOBBY", "class_name": "Lobby" },
          { "name": "ROOM", "class_name": "Room" },
          { "name": "REPORTS", "class_name": "Reports" }
        ]
      }
    }
  }
}
